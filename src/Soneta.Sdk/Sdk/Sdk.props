<?xml version="1.0" encoding="utf-8"?>

<Project ToolsVersion="14.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <IsAddonProject Condition="'$(UsingMicrosoftNETSdk)' != 'true'">true</IsAddonProject>
  </PropertyGroup>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" Condition="'$(IsAddonProject)' == 'true'"/>
  <PropertyGroup>
    <MSBuildAllProjects>$(MSBuildAllProjects);$(MSBuildThisFileFullPath)</MSBuildAllProjects>
    <IsTestProject Condition="$(IsTestProject) == '' AND $(MSBuildProjectName.Contains('Test'))">true</IsTestProject>
    <EnableDefaultSonetaPackageReferences Condition="$(EnableDefaultSonetaPackageReferences) == ''">true</EnableDefaultSonetaPackageReferences>
    <AggregateOutput Condition="$(AggregateOutput) == ''">true</AggregateOutput>
    <SonetaNUnitPackageVersion Condition="'$(SonetaNUnitPackageVersion)' == ''">4.4.0</SonetaNUnitPackageVersion>
    <SonetaNUnitTestAdapterPackageVersion Condition="'$(SonetaNUnitTestAdapterPackageVersion)' == ''">6.1.0</SonetaNUnitTestAdapterPackageVersion>
    <SonetaMicrosoftNETTestSdkPackageVersion Condition="'$(SonetaMicrosoftNETTestSdkPackageVersion)' == ''">18.0.1</SonetaMicrosoftNETTestSdkPackageVersion>
    <SonetaNSubstitutePackageVersion Condition="'$(SonetaNSubstitutePackageVersion)' == ''">5.3.0</SonetaNSubstitutePackageVersion>
    <SonetaNSubstituteAnalyzersCSharpPackageVersion Condition="'$(SonetaNSubstituteAnalyzersCSharpPackageVersion)' == ''">1.0.17</SonetaNSubstituteAnalyzersCSharpPackageVersion>
    <SonetaAwesomeAssertionsPackageVersion Condition="'$(SonetaAwesomeAssertionsPackageVersion)' == ''">9.3.0</SonetaAwesomeAssertionsPackageVersion>
    <UsingSonetaSdk>true</UsingSonetaSdk>
    <CopyLocalLockFileAssemblies Condition=" '$(IsAddonProject)' == 'true' ">true</CopyLocalLockFileAssemblies>
    <SonetaPackageReferenceNeedsVersion Condition="'$(ManagePackageVersionsCentrally)' != 'true'">true</SonetaPackageReferenceNeedsVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsAddonProject)' == 'true' AND '$(IsTestProject)' != 'true' AND $(SonetaAddonStartProgram) == ''">
    <SonetaDefaultInstallDirectory>$(MSBuildProgramFiles32)\Soneta</SonetaDefaultInstallDirectory>
    <SonetaCurrentVersionIndex Condition="Exists($(SonetaDefaultInstallDirectory))">$([MSBuild]::Add($([System.IO.Directory]::GetDirectories($(SonetaDefaultInstallDirectory)).Length), -1))</SonetaCurrentVersionIndex>
    <SonetaCurrentVersionDirectory Condition="$(SonetaCurrentVersionIndex) != '' AND $(SonetaCurrentVersionIndex) &gt; -1">$([System.IO.Directory]::GetDirectories($(SonetaDefaultInstallDirectory))[$(SonetaCurrentVersionIndex)])</SonetaCurrentVersionDirectory>
    <SonetaAddonStartProgram>$(SonetaCurrentVersionDirectory)\SonetaExplorer.exe</SonetaAddonStartProgram>
  </PropertyGroup>

  <!--
    Macierz mapowania SonetaPackage -> PackageReference

    Legenda kolumn:
      T+ A+ = IsTestProject=true,  IsAddonProject=true
      T+ A- = IsTestProject=true,  IsAddonProject!=true
      T- A+ = IsTestProject!=true, IsAddonProject=true
      T- A- = IsTestProject!=true, IsAddonProject!=true

    +=====================================+=======+=======+=======+=======+
    | SonetaPackage                       | T+ A+ | T+ A- | T- A+ | T- A- |
    +=====================================+=======+=======+=======+=======+
    | NUnit                               |  YES  |  YES  |  NO   |  NO   |
    | Soneta.Products.Test                |  YES  |  NO   |  NO   |  NO   |
    | NUnit3TestAdapter                   |  YES  |  YES  |  NO   |  NO   |
    | Microsoft.NET.Test.Sdk              |  YES  |  YES  |  NO   |  NO   |
    | NSubstitute                         |  NO   |  YES  |  NO   |  NO   |
    | NSubstitute.Analyzers.CSharp        |  NO   |  YES  |  NO   |  NO   |
    | AwesomeAssertions                   |  NO   |  YES  |  NO   |  NO   |
    | Soneta.Products.Modules             |  NO   |  NO   |  YES  |  NO   |
    +=====================================+=======+=======+=======+=======+
  -->
  <ItemGroup>
    <SonetaPackage Include="NUnit" Version="$(SonetaNUnitPackageVersion)" IsTestProject="true" />
    <SonetaPackage Include="Soneta.Products.Test" Version="$(SonetaPackageVersion)" IsTestProject="true" IsAddonProject="true" />
    <SonetaPackage Include="NUnit3TestAdapter" Version="$(SonetaNUnitTestAdapterPackageVersion)" IsTestProject="true" />
    <SonetaPackage Include="Microsoft.NET.Test.Sdk" Version="$(SonetaMicrosoftNETTestSdkPackageVersion)" IsTestProject="true" />
    <SonetaPackage Include="NSubstitute" Version="$(SonetaNSubstitutePackageVersion)" IsTestProject="true" IsAddonProject="false" />
    <SonetaPackage Include="NSubstitute.Analyzers.CSharp" Version="$(SonetaNSubstituteAnalyzersCSharpPackageVersion)" IsTestProject="true" IsAddonProject="false" />
    <SonetaPackage Include="AwesomeAssertions" Version="$(SonetaAwesomeAssertionsPackageVersion)" IsTestProject="true" IsAddonProject="false" />
    <SonetaPackage Include="Soneta.Products.Modules" Version="$(SonetaPackageVersion)" IsAddonProject="true" IncludeAssets="compile;buildTransitive" />
  </ItemGroup>
  <!-- PackageReference: IsTestProject=true, IsAddonProject dowolny -->
  <ItemGroup Condition="'$(EnableDefaultSonetaPackageReferences)' == 'true' AND '$(IsTestProject)' == 'true'">
    <PackageReference Include="@(SonetaPackage->WithMetadataValue('IsTestProject','true')->WithMetadataValue('IsAddonProject',''))"
      IsImplicitlyDefined="true" />
    <PackageReference Include="@(SonetaPackage->WithMetadataValue('IsTestProject','true')->WithMetadataValue('IsAddonProject','true'))"
      Condition="'$(IsAddonProject)' == 'true'"
      IsImplicitlyDefined="true" />
    <PackageReference Include="@(SonetaPackage->WithMetadataValue('IsTestProject','true')->WithMetadataValue('IsAddonProject','false'))"
      Condition="'$(IsAddonProject)' != 'true'"
      IsImplicitlyDefined="true" />
  </ItemGroup>
  <!-- PackageReference: IsTestProject='', IsAddonProject=true (np. Soneta.Products.Modules) -->
  <ItemGroup Condition="'$(EnableDefaultSonetaPackageReferences)' == 'true' AND '$(IsAddonProject)' == 'true'">
    <PackageReference Include="@(SonetaPackage->WithMetadataValue('IsTestProject','')->WithMetadataValue('IsAddonProject','true'))"
      IsImplicitlyDefined="true" />
  </ItemGroup>
</Project>
